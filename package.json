{
  "name": "finance-tracker",
  "private": true,
  "description": "Repository tooling only (formatting). The app itself lives in its own folders.",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
